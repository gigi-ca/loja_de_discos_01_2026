
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id            Int            @id @default(autoincrement())
  nome          String
  email         String         @unique
  senha         String
  movimentacoes Movimentacao[]
}

model Disco {
  id            Int            @id @default(autoincrement())
  titulo        String
  artista       String
  precoCusto    Float
  quantidade    Int
  estoqueMinimo Int
  movimentacoes Movimentacao[]
}

model Movimentacao {
  id         Int      @id @default(autoincrement())
  tipo       TipoMovimentacao
  quantidade Int
  data       DateTime @default(now())
  usuarioId  Int
  discoId    Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  disco   Disco   @relation(fields: [discoId], references: [id])
}

enum TipoMovimentacao {
  VENDA
  REPOSICAO
}
